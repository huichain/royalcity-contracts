# Copy to .env in this directory. Never commit .env.
#
#   cp env.sample .env
#
# WSL/Linux: use LF line endings (run `dos2unix .env` if variables look wrong).
# PRIVATE_KEY must include the 0x prefix.

# --- Required for forge script deployment ---

# Deployer wallet (use a dedicated testnet key, not your main wallet)
PRIVATE_KEY=0x

# RPC endpoint (example: Sepolia via Infura)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Optional: Etherscan API key for `forge script --verify` on Sepolia
ETHERSCAN_API_KEY=

# --- DeployRoyalCity constructor ---

# Set after running script/DeployMockUSDC.s.sol
PAYMENT_TOKEN=

# Treasury address (often the same as the deployer on testnet)
TREASURY=0x

BASE_URI=ipfs://royalcity/{id}.json

# Seconds before default admin transfer can complete (3600 = 1 hour for demos)
DEFAULT_ADMIN_DELAY=3600

# --- Filled after RoyalCity deploy (governance scripts / local notes) ---

ROYALCITY_CONTRACT=

# Optional: second wallet used for invest/claim demos via cast
INVESTOR_ADDRESS=

# --- Optional: governance rehearsal (stage B) ---

TIMELOCK=
TIMELOCK_DELAY=3600
TIMELOCK_PROPOSER_SAFE=
TIMELOCK_EXECUTOR=0x0000000000000000000000000000000000000000
TIMELOCK_TEMP_ADMIN=0x0000000000000000000000000000000000000000
COMPLIANCE_SAFE=
TREASURY_SAFE=
DEFAULT_ADMIN_TARGET=
REVOKE_DEPLOYER_MANAGER=false
REVOKE_DEPLOYER_COMPLIANCE=false
TIMELOCK_SALT=
